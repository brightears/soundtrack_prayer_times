<%- include('_head') %>

<div class="page-header">
  <div class="page-header__top">
    <div>
      <h1 class="page-header__title">Activity Log</h1>
      <p class="page-header__subtitle">Recent pause, resume, and call-to-prayer actions across all zones</p>
    </div>
    <div class="page-header__actions">
      <a href="/" class="btn btn--ghost">Back to Dashboard</a>
    </div>
  </div>
</div>

<div class="card" style="margin-bottom: 1rem;">
  <form method="get" action="/log" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem; align-items: end;">
    <div>
      <label class="field__label">Zone</label>
      <select name="zone" class="field__select">
        <option value="">All zones</option>
        <% for (const z of zoneOptions) { %>
          <option value="<%= z %>" <%= filters.zone === z ? 'selected' : '' %>><%= z %></option>
        <% } %>
      </select>
    </div>
    <div>
      <label class="field__label">Account</label>
      <select name="account" class="field__select">
        <option value="">All accounts</option>
        <% for (const a of accountOptions) { %>
          <option value="<%= a %>" <%= filters.account === a ? 'selected' : '' %>><%= a %></option>
        <% } %>
      </select>
    </div>
    <div>
      <label class="field__label">Prayer</label>
      <select name="prayer" class="field__select">
        <option value="">All prayers</option>
        <% for (const p of prayerOptions) { %>
          <option value="<%= p %>" <%= filters.prayer === p ? 'selected' : '' %>><%= p %></option>
        <% } %>
      </select>
    </div>
    <div>
      <label class="field__label">From (UTC date)</label>
      <input type="date" name="start" class="field__input" value="<%= filters.start %>">
    </div>
    <div>
      <label class="field__label">To (UTC date, inclusive)</label>
      <input type="date" name="end" class="field__input" value="<%= filters.end %>">
    </div>
    <div style="display: flex; gap: 0.5rem;">
      <button type="submit" class="btn btn--primary">Filter</button>
      <a href="/log" class="btn btn--ghost">Clear</a>
    </div>
  </form>
</div>

<% if (logs.length === 0) { %>
  <div class="card">
    <div class="empty-state">
      <div class="empty-state__icon">&#128196;</div>
      <div class="empty-state__title">No activity</div>
      <div class="empty-state__body">No log entries match these filters. Try clearing them or widening the date range.</div>
      <a href="/log" class="btn btn--primary">Clear filters</a>
    </div>
  </div>
<% } else { %>
  <% const ACTION_LABELS = { adhan: 'Call to Prayer', restore: 'Restore music', pause: 'Pause', resume: 'Resume', 'test-pause': 'Test pause', 'test-resume': 'Test resume' }; %>
  <div class="text-muted" style="margin-bottom: 0.5rem; font-size: var(--font-size-xs);">Showing <%= logs.length %> entries (most recent first, capped at 500).</div>
  <div class="data-table--wrapper">
    <table class="data-table">
      <thead>
        <tr>
          <th>Time (zone local)</th>
          <th>TZ</th>
          <th>Zone</th>
          <th>Account</th>
          <th>Action</th>
          <th>Prayer</th>
          <th>Result</th>
          <th>Error</th>
        </tr>
      </thead>
      <tbody>
        <% for (const log of logs) { %>
        <tr>
          <td style="white-space: nowrap;"><%= new Date(log.executed_at).toLocaleString('en-GB', { timeZone: log.zone_timezone || 'UTC', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }) %></td>
          <td style="white-space: nowrap;" class="text-muted"><%= log.zone_timezone || 'UTC' %></td>
          <td class="text-bold"><%= log.zone_name %></td>
          <td><%= log.account_name %></td>
          <td>
            <% const isAdhan = log.action === 'adhan' || log.action === 'restore'; %>
            <span class="prayer-pill<%= isAdhan ? ' prayer-pill--active' : '' %>"><%= ACTION_LABELS[log.action] || log.action %></span>
          </td>
          <td><%= log.prayer %></td>
          <td>
            <% if (log.success) { %>
              <span class="badge badge--success">OK</span>
            <% } else { %>
              <span class="badge badge--error">Failed</span>
            <% } %>
          </td>
          <td>
            <% if (log.error_message) { %>
              <span class="text-muted" title="<%= log.error_message %>" style="font-size: var(--font-size-xs); max-width: 200px; display: inline-block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                <%= log.error_message %>
              </span>
            <% } %>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('_foot') %>
